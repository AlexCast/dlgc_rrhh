# Plantilla de configuración de entorno.
#
# Uso en el servidor:
#   cp .env.example .env
#   editar .env con los datos reales
#   chown www-data:www-data .env && chmod 640 .env
#
# El archivo .env NO se versiona (.gitignore); este .env.example sí.
# app/conexion.php aborta con un mensaje genérico si falta DB_HOST, DB_NAME,
# DB_USER o DB_PASSWORD.

# --- Base de datos (obligatorias) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_dlgc_rrhh
DB_USER=dlgc_user
DB_PASSWORD=

# --- Aplicación ---
APP_ENV=production
APP_URL=https://lagrancacharreria.tech

# --- Correo (multi-proveedor vía API REST, con fallover) ---
# Remitente usado por todos los proveedores.
MAIL_FROM_ADDRESS=software@lagrancacharreria.tech
MAIL_FROM_NAME=Portal | DISTRIBUCIONES LA GRAN CACHARRERIA

# API keys de los proveedores. Cualquiera puede omitirse; el sistema usa
# únicamente las que estén definidas, en este orden de prioridad:
#   Brevo (principal) -> Resend (respaldo 1) -> MailerSend (respaldo 2).
BREVO_API_KEY=
RESEND_API_KEY=
MAILERSEND_API_KEY=

# Timeout de cURL en segundos para cada intento (opcional; por defecto 15).
MAILER_TIMEOUT=15

# Ruta del log de fallover (opcional; por defecto logs/mailer.log).
# MAIL_LOG_PATH=/ruta/absoluta/logs/mailer.log
